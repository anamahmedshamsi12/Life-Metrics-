# Copy this file to .env and fill in real values for local development.
# Never commit your actual .env file.

# Postgres connection string in production (e.g. Render). Leave unset
# locally to fall back to a SQLite file at src/life_metrics.db.
DATABASE_URL=

# Used to sign session cookies. Generate a real random value for any
# non-local environment, e.g.: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-key-change-me

FLASK_ENV=development
